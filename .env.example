# Airsell Cargo - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file - it contains sensitive information

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=airsell_user
DB_PASSWORD=your_secure_password
DB_NAME=airsell_cargo
DB_CHARSET=utf8mb4

# Application Settings
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost
APP_NAME="Airsell Cargo Portal"

# API Configuration
API_URL=https://api.airsell.local
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@airsell-cargo.com
MAIL_FROM_NAME="Airsell Cargo"

# Tracking System
TRACKING_API_URL=https://tracking.iata.org
TRACKING_API_KEY=your_tracking_key

# Security Settings
SESSION_TIMEOUT=3600
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_TYPES=pdf,doc,docx,xls,xlsx,jpg,png

# Logging
LOG_LEVEL=info
LOG_PATH=logs/

# Third-party Services
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
