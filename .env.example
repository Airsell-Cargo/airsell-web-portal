# Airsell Cargo API Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control

# ONE Record Cargo Tracking API
CARGO_API_KEY=your_cargo_api_key_here

# Optional: API Base URL (if using custom endpoints)
# CARGO_API_URL=https://api.example.com/cargo

# Database Configuration (if applicable)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=airsell_cargo
# DB_USER=root
# DB_PASSWORD=your_password_here

# Environment
# APP_ENV=production
# APP_DEBUG=false

# Logging
# LOG_LEVEL=error
# LOG_FILE=/var/log/airsell-cargo.log
